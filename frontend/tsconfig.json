{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    /* 🌍 Среда исполнения */
    "target": "ES2020",
    "module": "ESNext",               // стандартный для ts-loader + Webpack
    "moduleResolution": "Node",
    "lib": ["DOM", "ESNext"],
    "types": [],

    /* 🧩 Совместимость */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* 🔐 Проверки типов */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,

    /* ⚙️ Генерация и отладка */
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    /* 🧱 JSX (если используешь React) */
    "jsx": "react-jsx",

    /* 📦 Алиасы */
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}


